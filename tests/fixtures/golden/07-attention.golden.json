  "blockHtml": [
    "<section data-block-id=\"context\" data-type=\"markdown\" data-change=\"new\" class=\"block block-markdown\">\n<div class=\"change-badge-solo\"><span class=\"change-badge\"><span class=\"badge badge-new\" aria-label=\"新增\">＋NEW</span></span></div>\n\n\n\n<div class=\"block-content\"><p>Context</p></div>\n\n<div class=\"comment-area\" data-comment-area=\"context\">\n  <button class=\"comment-btn\" data-block-id=\"context\" aria-expanded=\"false\" aria-label=\"添加批注\">+批注</button>\n  <div class=\"comment-box\" data-comment-box=\"context\" hidden>\n    <div class=\"comment-edit\" data-comment-edit=\"context\">\n      <textarea class=\"comment-input\" data-comment-for=\"context\" rows=\"2\" placeholder=\"写下你的批注…\"></textarea>\n      <div class=\"comment-actions\">\n        <button class=\"comment-save\" data-comment-save=\"context\" type=\"button\">保存</button>\n        <button class=\"comment-delete\" data-comment-del=\"context\" type=\"button\">删除</button>\n      </div>\n    </div>\n    <div class=\"comment-read\" data-comment-read=\"context\" hidden>\n      <div class=\"comment-read-text\" data-comment-text=\"context\"></div>\n      <div class=\"comment-actions\">\n        <button class=\"comment-edit-btn\" data-comment-edit-btn=\"context\" type=\"button\">编辑</button>\n        <button class=\"comment-delete\" data-comment-del=\"context\" type=\"button\">删除</button>\n      </div>\n    </div>\n  </div>\n</div>\n</section>",
    "<section data-block-id=\"must\" data-type=\"verdict\" data-change=\"new\" class=\"block block-verdict\">\n<div class=\"change-badge-solo\"><span class=\"change-badge\"><span class=\"badge badge-new\" aria-label=\"新增\">＋NEW</span></span></div>\n\n\n\n<div class=\"block-content\"><div class=\"verdict-group\" role=\"group\" aria-label=\"表态\">\n  <button class=\"verdict-btn\" data-verdict=\"赞成\" data-block-id=\"must\" aria-label=\"赞成\">✓赞成</button>\n  <button class=\"verdict-btn\" data-verdict=\"异议\" data-block-id=\"must\" aria-label=\"异议\">✗异议</button>\n  <button class=\"verdict-btn\" data-verdict=\"疑问\" data-block-id=\"must\" aria-label=\"疑问\">?疑问</button>\n</div>\n<div class=\"verdict-comment\" hidden>\n  <textarea class=\"verdict-reason\" placeholder=\"请说明理由（推荐填写）\" data-block-id=\"must\" rows=\"2\"></textarea>\n</div></div>\n\n<div class=\"comment-area\" data-comment-area=\"must\">\n  <button class=\"comment-btn\" data-block-id=\"must\" aria-expanded=\"false\" aria-label=\"添加批注\">+批注</button>\n  <div class=\"comment-box\" data-comment-box=\"must\" hidden>\n    <div class=\"comment-edit\" data-comment-edit=\"must\">\n      <textarea class=\"comment-input\" data-comment-for=\"must\" rows=\"2\" placeholder=\"写下你的批注…\"></textarea>\n      <div class=\"comment-actions\">\n        <button class=\"comment-save\" data-comment-save=\"must\" type=\"button\">保存</button>\n        <button class=\"comment-delete\" data-comment-del=\"must\" type=\"button\">删除</button>\n      </div>\n    </div>\n    <div class=\"comment-read\" data-comment-read=\"must\" hidden>\n      <div class=\"comment-read-text\" data-comment-text=\"must\"></div>\n      <div class=\"comment-actions\">\n        <button class=\"comment-edit-btn\" data-comment-edit-btn=\"must\" type=\"button\">编辑</button>\n        <button class=\"comment-delete\" data-comment-del=\"must\" type=\"button\">删除</button>\n      </div>\n    </div>\n  </div>\n</div>\n</section>",
